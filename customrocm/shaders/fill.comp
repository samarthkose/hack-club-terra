// CROC built-in kernel: strided fill of a uint32 storage buffer.
//
// Must stay in sync with the push constant layout used by device.c:
//   word 0: count    (element count, derived from bound buffer size)
//   word 1: pattern  (set via croc_kernel_set_arg(k, 1, &pat, 4))
//   word 2: stride   (workgroup_count_x * local_size)
//
// Compile offline (aipc build):
//   glslangValidator -V shaders/fill.comp -o build/fill.spv
// The Makefile embeds build/fill.spv into build/fill_spv.h (scripts/spv_to_header.py).

#version 450

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform Push {
    uint count;
    uint pattern;
    uint stride;
} pc;

layout(set = 0, binding = 0, std430) buffer Data {
    uint words[];
} data;

void main() {
    uint i = gl_GlobalInvocationID.x;
    while (i < pc.count) {
        data.words[i] = pc.pattern;
        i += pc.stride;
    }
}